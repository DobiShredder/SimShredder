{
  "name": "@simshredder/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm locale:check && tsc -b config/tsconfig.json && vite build --config config/vite.config.ts",
    "check": "pnpm locale:check && tsc -b config/tsconfig.json --pretty false",
    "dev": "vite --config config/vite.config.ts",
    "build:wdio": "pnpm locale:check && tsc -b config/tsconfig.json && vite build --config config/vite.config.ts --mode wdio",
    "e2e:build": "tauri build --debug --no-bundle --features wdio --config src-tauri/tauri.wdio.conf.json",
    "e2e": "wdio run config/wdio.conf.ts",
    "locale:check": "node ../../tooling/localization/check-locales.mjs",
    "tauri": "tauri",
    "test": "vitest run --config config/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.21",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.6.0",
    "echarts": "6.1.0",
    "i18next": "26.4.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.13.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@wdio/cli": "9.31.3",
    "@wdio/local-runner": "9.31.3",
    "@wdio/mocha-framework": "9.31.2",
    "@wdio/spec-reporter": "9.31.2",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/visual-service": "10.1.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "jsdom": "29.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
